# Copy this file to .env and change the secret.
PORT=5000
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed frontend origins (CORS)
CLIENT_ORIGIN=http://localhost:5173,http://localhost:4173
# Invite code needed to register an admin account
ADMIN_INVITE_CODE=CT-ADMIN-2026
